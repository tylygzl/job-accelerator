# Job Accelerator LLM config
#
# Copy this file to .env and fill your own key. Never commit .env.
#
# Recommended generic format:
#   LLM_PROVIDER=<provider>
#   LLM_API_KEY=<your-api-key>
#   LLM_MODEL=<model-or-endpoint-id>
#   LLM_BASE_URL=<optional-openai-compatible-base-url>
#
# Supported LLM_PROVIDER values:
#   none              local fallback only, no model API
#   deepseek          DeepSeek OpenAI-compatible API
#   volcengine        Doubao / Volcengine Ark
#   qwen              Alibaba DashScope Qwen
#   moonshot          Kimi / Moonshot
#   zhipu             Zhipu GLM
#   siliconflow       SiliconFlow model gateway
#   openrouter        OpenRouter model gateway
#   openai            Official OpenAI API
#   openai-compatible Any custom OpenAI-compatible gateway

LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Examples, keep only one provider block when you actually use it.
#
# DeepSeek:
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash
#
# Doubao / Volcengine Ark:
# LLM_PROVIDER=volcengine
# LLM_MODEL=your-ark-endpoint-or-model-id
#
# Qwen / DashScope:
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-plus
#
# Kimi / Moonshot:
# LLM_PROVIDER=moonshot
# LLM_MODEL=moonshot-v1-8k
#
# Zhipu GLM:
# LLM_PROVIDER=zhipu
# LLM_MODEL=glm-4-flash
#
# Generic company gateway:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_MODEL=your-model-name

# Optional proxy. Leave empty if your LLM API works directly.
HTTPS_PROXY=

# Performance switches.
# The app first runs a local fast score and only calls the model for high-potential jobs.
LLM_MIN_SCORE=75
LLM_OPENING=true
LLM_MATCHER=false
LLM_RESUME_EXTRACTOR=auto
RESUME_EXTRACT_ATTEMPTS=1
LLM_JD_DECOMPOSER=false

# Backward-compatible DeepSeek variables still work, but are not recommended for new users.
# Prefer LLM_PROVIDER / LLM_API_KEY / LLM_MODEL / LLM_BASE_URL above.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

LANGSMITH_TRACING=false
