# Job Accelerator LLM config
#
# Modes:
# - none: local fallback only, no API key needed
# - deepseek: DeepSeek OpenAI-compatible API
# - openai-compatible: Qwen/GLM/Doubao/company gateway, fill LLM_BASE_URL
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/v1

# Optional proxy. Leave empty if your LLM API works directly.
HTTPS_PROXY=

# Backward-compatible DeepSeek variables still work if LLM_* is not set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

LANGSMITH_TRACING=false
