[Unit]
Description=Job Accelerator FastAPI backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/job-accelerator
EnvironmentFile=/opt/job-accelerator/.env
ExecStart=/opt/job-accelerator/.venv/bin/python -m uvicorn server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
